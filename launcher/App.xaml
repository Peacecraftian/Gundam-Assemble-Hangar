<Application xmlns:local="clr-namespace:Hangar.Launcher" x:Class="Hangar.Launcher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Chassis" Color="#020504" />
    <SolidColorBrush x:Key="Panel" Color="#091710" />
    <SolidColorBrush x:Key="Well" Color="#050D08" />
    <SolidColorBrush x:Key="Rail" Color="#0C1C14" />
    <SolidColorBrush x:Key="Ink" Color="#9EFFC6" />
    <SolidColorBrush x:Key="Muted" Color="#86CBA2" />
    <SolidColorBrush x:Key="Edge" Color="#84E7AB" />
    <SolidColorBrush x:Key="Amber" Color="#FFB64D" />
    <SolidColorBrush x:Key="Enamel" Color="#E2DACA" />
    <SolidColorBrush x:Key="Ready" Color="#9EFFC6" />
    <SolidColorBrush x:Key="Danger" Color="#FFD6D1" />
    <RadialGradientBrush x:Key="VentMist">
      <GradientStop Color="#A5CEE6CD" Offset="0"/>
      <GradientStop Color="#6399BEA3" Offset="0.45"/>
      <GradientStop Color="#0086A894" Offset="1"/>
    </RadialGradientBrush>
    <DrawingImage x:Key="KeyPuff">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="{StaticResource VentMist}" Geometry="M0,10 A15,6 0 1 0 30,10 A15,6 0 1 0 0,10"/>
          <GeometryDrawing Brush="{StaticResource VentMist}" Geometry="M12,9 A18,9 0 1 0 48,9 A18,9 0 1 0 12,9"/>
          <GeometryDrawing Brush="{StaticResource VentMist}" Geometry="M32,13 A14,6 0 1 0 60,13 A14,6 0 1 0 32,13"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <FontFamily x:Key="Heading">pack://application:,,,/Assets/Fonts/#Chakra Petch</FontFamily>
    <FontFamily x:Key="Stencil">pack://application:,,,/Assets/Fonts/#Saira Stencil One</FontFamily>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Meta" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontFamily" Value="{StaticResource Heading}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="36" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#0A1811" />
      <Setter Property="BorderBrush" Value="#80E6A9" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontFamily" Value="{StaticResource Heading}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="Padding" Value="20,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Assembly" Background="Transparent">
              <local:KeyFace x:Name="Face" Depressed="{TemplateBinding IsPressed}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
              </local:KeyFace>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Amber}" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#D1EDFF" /><Setter TargetName="Face" Property="BorderThickness" Value="3" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Assembly" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SupportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Rail}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="24" />
    </Style>
  </Application.Resources>
</Application>
