<Window x:Class="Hangar.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Hangar Terminal" Width="1280" Height="820" MinWidth="640" MinHeight="440" WindowStartupLocation="CenterScreen"
 Background="#020504" Foreground="{StaticResource Ink}" FontFamily="Consolas" UseLayoutRounding="True" PreviewKeyDown="OnKeyDown">
 <Window.Resources>
  <BitmapImage x:Key="Concept" UriSource="Display/terminal-concept.png" CacheOption="OnLoad"/>
  <CroppedBitmap x:Key="Mark" Source="{StaticResource Concept}" SourceRect="42,28,404,96"/>
  <CroppedBitmap x:Key="Drawing" Source="{StaticResource Concept}" SourceRect="784,138,488,558"/>
  <CroppedBitmap x:Key="Instruments" Source="{StaticResource Concept}" SourceRect="1280,138,350,560"/>
  <CroppedBitmap x:Key="Vent" Source="{StaticResource Concept}" SourceRect="1457,61,164,37"/>
 </Window.Resources>
 <Grid x:Name="Shell" TextElement.FontFamily="Consolas" Background="#020504">
  <Border Margin="9" CornerRadius="26" Background="#08130F" BorderBrush="#293D32" BorderThickness="2" Padding="26,17">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="0.14*"/><RowDefinition Height="*"/><RowDefinition Height="0.12*" MinHeight="62"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="2.5*"/><ColumnDefinition Width=".42*"/></Grid.ColumnDefinitions>
     <Image Source="{StaticResource Mark}" Stretch="Uniform" HorizontalAlignment="Left" AutomationProperties.Name="Gundam Assemble Hangar"/>
     <Border Grid.Column="1" BorderThickness="2,0,0,0" BorderBrush="{StaticResource Edge}" VerticalAlignment="Center" Margin="24,0" Padding="22,0">
      <TextBlock x:Name="TerminalLabel" Text="HANGAR TERMINAL" FontSize="24" FontWeight="Bold"/>
     </Border>
     <Image Grid.Column="2" Source="{StaticResource Vent}" Stretch="Uniform" HorizontalAlignment="Right" MaxWidth="180"/>
    </Grid>
    <Grid Grid.Row="1" Margin="0,4,0,12">
     <Grid x:Name="HomePanel">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="CommandColumn" Width="46*"/><ColumnDefinition x:Name="ArtColumn" Width="54*"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,12,0">
       <Grid.RowDefinitions><RowDefinition Height="1.0*"/><RowDefinition Height=".35*" MinHeight="60"/><RowDefinition Height=".27*" MinHeight="56"/><RowDefinition Height=".27*" MinHeight="56"/></Grid.RowDefinitions>
       <Border BorderThickness="0,2,1,1" BorderBrush="{StaticResource Edge}" Padding="12,4,16,6" Margin="0,0,0,8">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center">
         <StackPanel Width="600">
          <Viewbox Stretch="Uniform"><TextBlock Text="SYSTEM READY" TextWrapping="NoWrap" FontFamily="{StaticResource Heading}" FontWeight="Bold" FontSize="66"/></Viewbox>
          <TextBlock Text="RECOVERED SYSTEM  /  SYSTEM CHECKS OK" FontSize="20" Margin="2,0,0,10"/>
          <Border Height="2" Background="{StaticResource Edge}" Margin="0,0,0,12"/>
          <TextBlock x:Name="Diagnostics" FontSize="19" LineHeight="27" TextWrapping="NoWrap"/>
         </StackPanel>
        </Viewbox>
       </Border>
       <Button x:Name="LaunchButton" Grid.Row="1" Margin="0,0,0,6" Background="{StaticResource Amber}" BorderBrush="{StaticResource Amber}" Foreground="#111609" Click="LaunchPrimary" AutomationProperties.Name="Enter Hangar">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Left"><TextBlock x:Name="LaunchTitle" Foreground="#111609" Text="▶  ENTER HANGAR" FontSize="55" FontWeight="Bold"/></Viewbox>
       </Button>
       <Button Grid.Row="2" x:Name="ReferenceButton" Click="ShowReferences" Margin="0,3,0,3" AutomationProperties.Name="REFERENCE">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><Rectangle Width="32" Height="32" Margin="0,0,18,0" Fill="{StaticResource Ink}"><Rectangle.OpacityMask><ImageBrush ImageSource="Assets/gallery-vertical-end.png"/></Rectangle.OpacityMask></Rectangle><TextBlock Text="REFERENCE" FontSize="37" FontWeight="Bold"/></StackPanel></Viewbox>
       </Button>
       <Button Grid.Row="3" x:Name="ToolsButton" Click="ShowTools" Margin="0,3,0,3" AutomationProperties.Name="TOOLS">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><Rectangle Width="32" Height="32" Margin="0,0,18,0" Fill="{StaticResource Ink}"><Rectangle.OpacityMask><ImageBrush ImageSource="Assets/sliders-vertical.png"/></Rectangle.OpacityMask></Rectangle><TextBlock Text="TOOLS" FontSize="37" FontWeight="Bold"/></StackPanel></Viewbox>
       </Button>
      </Grid>
      <Grid x:Name="ArtPanel" Grid.Column="1" IsHitTestVisible="False" AutomationProperties.Name="Bay 01 hangar schematic and illustrated instruments">
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height=".14*" MinHeight="42"/></Grid.RowDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.395*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Image Source="{StaticResource Drawing}" Stretch="Fill" Margin="0,0,8,4"/>
        <Viewbox Grid.Column="1" Stretch="Fill" Margin="0,0,0,4">
         <Canvas Width="350" Height="560">
          <Image Source="{StaticResource Instruments}" Width="350" Height="560"/>
          <!-- Unlit sectors sit over the printed phosphor so the original dial lights up in place. -->
          <Path x:Name="PilotUnlit" Stroke="#EA0A140E" StrokeThickness="23"/>
          <Border Canvas.Left="130" Canvas.Top="175" Width="102" Height="37" Background="#0B150E">
           <TextBlock x:Name="PilotPercent" Text="100%" HorizontalAlignment="Center" VerticalAlignment="Center"
                      TextWrapping="NoWrap" FontFamily="Consolas" FontWeight="Bold" FontSize="35" Foreground="#A0FFC4"/>
          </Border>
          <!-- Position the editable caption in the instrument artwork's own coordinates. -->
          <Border Canvas.Left="14" Canvas.Top="359" Width="318" Height="31" Padding="16,0">
           <Border.Background>
            <ImageBrush ImageSource="{StaticResource Instruments}" ViewboxUnits="Absolute" Viewbox="312,359,16,31" ViewportUnits="Absolute" Viewport="0,0,16,31" TileMode="Tile"/>
           </Border.Background>
           <TextBlock Text="MINOVSKY DENSITY" VerticalAlignment="Center" FontSize="25" FontWeight="Bold" Foreground="#85F7B0"/>
          </Border>
          <Grid Canvas.Left="26" Canvas.Top="418" Width="300" Height="58" ClipToBounds="True">
           <Grid.Background>
            <DrawingBrush TileMode="Tile" Viewport="0,0,30,29" ViewportUnits="Absolute"
                          Viewbox="0,0,30,29" ViewboxUnits="Absolute">
             <DrawingBrush.Drawing>
              <DrawingGroup>
               <GeometryDrawing Brush="#0A150E" Geometry="M0,0 H30 V29 H0 Z"/>
               <GeometryDrawing Brush="#285039" Geometry="M5,0 H6 V2 H5 Z M5,5 H6 V7 H5 Z M5,10 H6 V12 H5 Z M5,15 H6 V17 H5 Z M5,20 H6 V22 H5 Z M5,25 H6 V27 H5 Z"/>
              </DrawingGroup>
             </DrawingBrush.Drawing>
            </DrawingBrush>
           </Grid.Background>
           <Path x:Name="DensityTrace" Stroke="#90F5B1" StrokeThickness="1.9" StrokeLineJoin="Round"/>
          </Grid>
         </Canvas>
        </Viewbox>
       </Grid>
       <Border Grid.Row="1" BorderBrush="{StaticResource Edge}" BorderThickness="2" CornerRadius="5" Margin="0,6,0,3">
        <Viewbox HorizontalAlignment="Left" Stretch="Uniform"><StackPanel Margin="8,1"><Border Background="{StaticResource Ink}" HorizontalAlignment="Left" Padding="8,0"><TextBlock Text="HANGAR FUNCTIONS" Foreground="#08130F" FontSize="16"/></Border><TextBlock Text=" MISSION SORTIE   /   BATTLEFIELD   /   MATCH CONSOLE   /   TACTICS " FontSize="16" Margin="0,3,0,0"/></StackPanel></Viewbox>
       </Border>
      </Grid>
     </Grid>
     <ScrollViewer x:Name="MainScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
      <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
       <Button x:Name="BackButton" Content="‹   BACK TO TERMINAL" HorizontalAlignment="Left" Click="ShowHome" Margin="0,4,0,12"/>
       <TextBlock x:Name="DetailTitle" Style="{StaticResource Title}"/><TextBlock x:Name="DetailDescription" Foreground="{StaticResource Muted}" Margin="0,5,0,15"/>
       <StackPanel x:Name="DetailItems"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" BorderThickness="0,2,0,0" BorderBrush="{StaticResource Edge}" Padding="4,4,0,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M0,21 L16,0 H26 L10,21 Z M22,21 L38,0 H48 L32,21 Z M44,21 L60,0 H70 L54,21 Z" Fill="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,16,0"/><Viewbox Grid.Column="1" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="StatusText" MaxWidth="970" FontSize="36" FontWeight="Bold" Text="READY FOR SORTIE"/></Viewbox></Grid>
      <Button x:Name="MaintenanceButton" Grid.Column="1" Content="⚙  MAINTENANCE" FontSize="20" VerticalAlignment="Center" Click="ShowMaintenance" AutomationProperties.Name="Maintenance and desktop exit"/>
     </Grid>
    </Border>
   </Grid>
  </Border>
  <Canvas x:Name="PressEffects" IsHitTestVisible="False" ClipToBounds="True"/>
 </Grid>
</Window>

